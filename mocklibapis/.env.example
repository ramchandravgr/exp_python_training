# Mock Library API configuration
# Copy this file to .env and adjust values as needed:
#   copy .env.example .env
#
# Blank values are ignored — built-in defaults are used instead.

# Dataset: small (default) or large (5M paginated books)
MOCKLIB_DATASET=small
MOCKLIB_PAGE_SIZE=50000
MOCKLIB_TOTAL_PAGES=100

# Optional override for both zipcode + pagination sources.
# Leave blank to auto-resolve from MOCKLIB_DATASET:
#   small → data/libraries_small.json
#   large → data/books_manifest.json + data/books_pages/
MOCKLIB_DATA_FILE=

# Server
MOCKLIB_HOST=127.0.0.1
MOCKLIB_PORT=
MOCKLIB_PORT_START=5000
MOCKLIB_PORT_END=5050

# Simulated GET failures (0.0 to 1.0)
MOCKLIB_FAILURE_RATE=0.20
MOCKLIB_TIMEOUT_RATE=0.10
MOCKLIB_NOT_FOUND_RATE=0.05
MOCKLIB_DISABLE_FAILURES=

# Response timing (seconds)
MOCKLIB_MIN_DELAY=0.1
MOCKLIB_MAX_DELAY=0.5
MOCKLIB_TIMEOUT_DELAY=2.0
